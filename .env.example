# Copy to .env and edit. Every value here is a default — delete any line you
# are happy with. No secrets are required; everything runs locally.

# ── Ollama ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
EMBEDDING_MODEL=bge-m3
# Must match the output dimension of EMBEDDING_MODEL (bge-m3 = 1024,
# nomic-embed-text = 768, mxbai-embed-large = 1024).
EMBEDDING_DIM=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=180
EMBED_TIMEOUT_SECONDS=60

# ── Qdrant ───────────────────────────────────────────────────────────
# server = HTTP instance | local = embedded on-disk | memory = wiped on restart
QDRANT_MODE=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Only used when QDRANT_MODE=local. Defaults to ./qdrant_data
# QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=mentor_knowledge
QDRANT_SEARCH_LIMIT=5

# ── Weight dynamics ──────────────────────────────────────────────────
WEIGHT_MOMENTUM=0.35
MIN_WEIGHT_THRESHOLD=0.05
TOPIC_SIMILARITY_THRESHOLD=0.45
EMBEDDING_SCORE_WEIGHT=0.6
DOMAIN_SCORE_WEIGHT=0.4
TRAJECTORY_WINDOW=3
TRAJECTORY_BONUS=0.10

# ── Council mode ─────────────────────────────────────────────────────
COUNCIL_TOP_N=4
COUNCIL_MIN_SCORE_GAP=0.15

# ── Session store ────────────────────────────────────────────────────
MAX_HISTORY_MESSAGES=20
MAX_SESSIONS=500

# ── Server ───────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
SEED_ON_STARTUP=true
